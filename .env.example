# ============================================================
# 本地开发环境变量示例
# 复制为 .env 后填写真实值，.env 不提交 git
# ============================================================

# ---- 运行环境 ----
NODE_ENV=development
LOG_LEVEL=info
LOG_DIR=   # 留空则默认 logs/api 或 logs/worker（相对 monorepo 根目录）

# ---- 服务端口 ----
API_PORT=7001
API_HOST=0.0.0.0
WORKER_PORT=3002

# ---- 服务间通信 URL ----
INTERNAL_API_URL=http://localhost:7001
WEB_BASE_URL=http://localhost:6006
API_BASE_URL=http://localhost:7001

# ---- 数据库 ----
DATABASE_URL=postgresql://aigc:aigcpass@localhost:5432/aigc_dev
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000

# ---- Redis ----
REDIS_URL=redis://localhost:6379/1

# ---- JWT ----
JWT_SECRET=change-me-in-production-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ---- CORS（逗号分隔的允许来源）----
CORS_ORIGIN=http://localhost:6006

# ============================================================
# 对象存储 - 火山引擎 TOS
# 开发和生产环境统一使用 TOS
# ============================================================

TOS_ACCESS_KEY_ID=           # 火山引擎 AccessKeyId
TOS_SECRET_ACCESS_KEY=       # 火山引擎 SecretAccessKey
TOS_REGION=cn-shanghai
TOS_ENDPOINT=https://tos-cn-shanghai.volces.com
TOS_BUCKET=toby-ai-dev       # 生产改为 toby-ai-prod
TOS_PUBLIC_URL=https://toby-ai-dev.tos-cn-shanghai.volces.com

# ============================================================
# AI 服务
# ============================================================

# ---- Nacos 配置中心（AI 参数热更） ----
# AI provider 的 key/endpoint/model/timeout 必须由 Nacos 下发，不再在 .env 兜底。
# 本地开发如需启动 api/worker，请先用 `docker-compose --profile nacos up -d` 起 Nacos，
# 再导入 deploy/nacos/configs/*.properties。
# Nacos 自身连接参数不能放进 Nacos（鸡生蛋），所以仍由容器 env 提供。
# 部署与 DataID/Group 规划见 deploy/nacos/README.md。
NACOS_SERVER_ADDR=             # 形如 10.0.0.5:8848；本地填 localhost:8848；不能为空
NACOS_NAMESPACE=public         # 命名空间 ID：dev / staging / production
NACOS_USERNAME=                # Nacos 开启鉴权后必填（首登改密后的账号）
NACOS_PASSWORD=                # 同上

# 以下为本地兜底值，实际生产从 Nacos（对应 DataID）下发，热更生效。
# 算力巴士 Tokenbus（图片生成：全能图片Pro/2、超能图片2）
TOKENBUS_API_BASE_URL=https://tokenbus.wangpudata.com
TOKENBUS_API_KEY=

# AI system prompts 从 ./prompts.env 加载
# 复制 prompts.env.example 为 prompts.env 并填写私有提示词

# 音色克隆积分配置属于计费体系，仍走本地 env / DB 配置，不属于 provider 鉴权参数。
MUSIC_VOICE_CLONE_CREDITS=5

# 开放接口回调签名密钥（HMAC-SHA256，worker 回调时对紧凑 JSON body 签名）
CALLBACK_SIGNATURE_SECRET=xxx

# 开放接口调用方占位积分余额（可选，默认 1_000_000_000；开放接口任务零积分，仅过余额校验用）
OPENAPI_CREDIT_BALANCE=1000000000

# 代理基础 URL：worker 将内网存储 URL 包装为外部可访问的代理地址
# 本地开发填 http://localhost:7001，生产填 API 服务器公网地址
AVATAR_UPLOAD_BASE_URL=http://localhost:7001

# ============================================================
# 支付（生活平台）
# 域名向生活平台负责人申请，getToken/orderGenerate/payViewWAP 同域名
# ============================================================
LIFE_SERVICE_BASE_URL=https://[生活平台域名]
LIFE_SERVICE_APP_ID=
LIFE_SERVICE_SECRET=
LIFE_SERVICE_PLATFORM_CODE=

# 包月订阅参数（需对方提供）
LIFE_SERVICE_TEMPLATE_CODE=PENDING
LIFE_SERVICE_SKU_ID=PENDING
LIFE_SERVICE_SPU_ID=PENDING
LIFE_SERVICE_AREA_CODE=025

# ============================================================
# Toby 业务管理平台开放接口
# 用于会员、A豆、订购、模型规格同步等接口联调
#
# 签名文档中的签名字段只有 4 个：
#   appID、appSecret、timestamp、serviceCode
# 下面环境变量是本项目本地接入配置，并非全部参与签名。
# ============================================================

# 出站：我们调用 Toby 业管平台。
# Toby 平台接口根地址；仅用于本项目发起 HTTP 请求，不参与签名。
# 测试环境文档地址示例：http://61.155.229.73:18080
TOBY_OUTBOUND_BASE_URL=http://61.155.229.73:18080

# Toby 分配给本项目的应用标识。
# 对应签名字段 appID，同时也会放入外层请求报文 appID。
TOBY_OUTBOUND_APP_ID=xxx

# Toby 分配给本项目的签名密钥。
# 对应签名字段 appSecret，只用于本地生成/校验 MD5 签名，不会明文发送给对方。
TOBY_OUTBOUND_APP_SECRET=xxx

# Toby 加解密密钥。
# 对应 Java 示例中的 properties.getPrivateKey()，用于 DES/CBC/PKCS5Padding 加解密 requestJson/responseJson。
# 不参与 MD5 签名；按 Java DESKeySpec 行为使用 UTF-8 编码后的前 8 字节作为 DES key。
TOBY_OUTBOUND_PRIVATE_KEY=xxx

# 入站：Toby 业管平台调用我们开放接口。
# 这组 appID/appSecret/privateKey 由我们提供给业管平台，专用于校验和解密业管推送。
TOBY_INBOUND_APP_ID=xxx
TOBY_INBOUND_APP_SECRET=xxx
TOBY_INBOUND_PRIVATE_KEY=xxx

# 签名时间戳有效期，单位：秒。
# 文档要求当前有效期为 10 分钟，因此默认 600；只用于本地校验响应/回调是否过期，不参与签名。
TOBY_SIGNATURE_VALID_SECONDS=600

# ============================================================
# 其他外部服务（按需填写）
# ============================================================
EXTERNAL_STORAGE_URL=
EXTERNAL_STORAGE_BASE=
COMPANY_A_IMAGE_BASE=
NEXT_PUBLIC_API_URL=
