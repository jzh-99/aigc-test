# Web 服务器环境变量
# 复制为 .env 后填写真实值

# ---- API 服务器地址（服务端 SSR/代理用）----
API_HOST=YOUR_API_SERVER_IP           # API 服务器 IP 或域名
API_PORT=7001

# ---- 对象存储地址（浏览器直接访问）----
# 填写火山引擎 TOS 的公网域名（如 toby-ai-prod.tos-cn-shanghai.volces.com）
NEXT_PUBLIC_STORAGE_HOST=toby-ai-prod.tos-cn-shanghai.volces.com
NEXT_PUBLIC_STORAGE_PORT=443          # TOS 使用 HTTPS，端口 443

# ---- Web 端口 ----
WEB_PORT=6006
