# API 服务器环境变量
# 复制为 .env 后填写真实值

# ---- 运行环境 ----
NODE_ENV=production
LOG_LEVEL=info
LOG_DIR=   # Docker 部署时由 docker-compose.yml 注入 /app/logs/api，本地留空

# ---- 服务端口 ----
API_PORT=7001

# ---- 基础设施服务器地址 ----
INFRA_HOST=192.168.1.100        # 基础设施服务器 IP 或域名

# ---- 数据库（docker-compose 动态拼接，以下分量必须填写）----
POSTGRES_USER=aigc
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=aigc_dev
POSTGRES_PORT=5432
PG_POOL_MAX=20
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000

# ---- Redis ----
REDIS_PORT=6379
REDIS_PASSWORD=                  # 与基础设施服务器保持一致

# ---- JWT ----
JWT_SECRET=change-me-in-production-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ---- CORS（允许 web 服务器访问）----
# 生产环境：如果前端有域名，必须填域名；HTTPS 部署必须写 https://
# 示例：https://aigc.example.com 或 http://192.168.1.101:6006
CORS_ORIGIN=http://WEB_SERVER_IP:6006

# ---- Cookie 安全 ----
# HTTPS 部署时设为 true，HTTP 部署时设为 false（否则浏览器会拒绝存储 Cookie）
COOKIE_SECURE=false

# ---- 服务间通信 URL ----
WEB_BASE_URL=http://WEB_SERVER_IP:6006
API_BASE_URL=http://API_SERVER_IP:7001

# ---- 火山引擎 TOS 对象存储 ----
# 生产环境 STORAGE_DRIVER 留空（走 TOS），不要设置 S3_* 变量
TOS_ACCESS_KEY_ID=change-me-access-key-id
TOS_SECRET_ACCESS_KEY=change-me-secret-access-key
TOS_REGION=cn-shanghai
TOS_ENDPOINT=https://tos-cn-shanghai.volces.com
TOS_BUCKET=toby-ai-prod
TOS_PUBLIC_URL=https://toby-ai-prod.tos-cn-shanghai.volces.com

# ---- 第三方 AI 服务 ----
VOLCENGINE_API_KEY=
VOLCENGINE_ACCESS_KEY=
VOLCENGINE_SECRET_KEY=

# TokenHub（Seedream 图片 + Seedance 视频，OpenAI 兼容接口）
TOKENHUB_API_BASE_URL=https://aigw.telecomjs.com
TOKENHUB_API_KEY=

# 天翼云边缘AI网关（Seedream 图片 + Seedance 视频）
CTYUN_EDGE_API_BASE_URL=https://ai.ctaigw.cn/v1
CTYUN_EDGE_API_KEY=

# ---- AI Chat 模型切换：doubao（默认）| nano_banana ----
AI_CHAT_PROVIDER=doubao

# 豆包 doubao-seed-2-0-lite-260428（火山方舟）
DOUBAO_API_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_API_KEY=
DOUBAO_MODEL=doubao-seed-2-0-lite-260428

# Nano Banana（canvas-agent / video-studio / ai-assistant 备用通道）
NANO_BANANA_API_URL=
NANO_BANANA_API_KEY=
NANO_BANANA_MODEL=

# Qwen（通义千问，画布文本节点 AI 生成专用）
QWEN_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
QWEN_MODEL=qwen3.7-max

# MiniMax（语音合成）
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_TTS_TIMEOUT_MS=60000

# Mureka（音乐生成 / 音色克隆）
MUREKA_API_KEY=
MUREKA_API_URL=

# ---- AI system prompts（生产需要直接写入本文件或通过服务器环境注入）----
# 推荐做法：将 prompts 单独管理在 prompts.env 文件中
# 复制 prompts.env.example 为 prompts.env 后填写
# docker-compose.yml 会自动加载 prompts.env
AI_PROMPT_ASSISTANT=
AI_PROMPT_CANVAS_AGENT=
AI_PROMPT_CANVAS_SCRIPT_WRITER=
AI_PROMPT_CANVAS_STORYBOARD_SPLIT=
AI_PROMPT_STUDIO_SCRIPT=
AI_PROMPT_STUDIO_STORYBOARD=
AI_PROMPT_STUDIO_ASSET=
AI_PROMPT_STUDIO_SERIES_OUTLINE=

# ---- 代理基础 URL ----
# worker 将内网存储 URL 包装为外部可访问的代理地址，填写 API 服务器公网地址
AVATAR_UPLOAD_BASE_URL=http://API_SERVER_IP:7001
AI_UPLOAD_BASE_URL=http://API_SERVER_IP:7001

# ---- 缩略图签名 ----
THUMBNAIL_SECRET=change-me-thumbnail-secret

# ---- 其他外部服务 ----
NEXT_PUBLIC_API_URL=
EXTERNAL_STORAGE_BASE=
EXTERNAL_STORAGE_URL=           # 与 EXTERNAL_STORAGE_BASE 二选一，优先级更高
COMPANY_A_IMAGE_BASE=

# ---- 支付（生活平台）----
LIFE_SERVICE_BASE_URL=
LIFE_SERVICE_APP_ID=
LIFE_SERVICE_SECRET=
LIFE_SERVICE_PLATFORM_CODE=
WEB_BASE_URL=http://WEB_SERVER_IP:6006
API_BASE_URL=http://API_SERVER_IP:7001

# 包月订阅参数（需对方提供）
LIFE_SERVICE_TEMPLATE_CODE=PENDING
LIFE_SERVICE_SKU_ID=PENDING
LIFE_SERVICE_SPU_ID=PENDING
LIFE_SERVICE_AREA_CODE=025
