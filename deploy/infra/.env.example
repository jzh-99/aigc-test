# 基础设施服务器环境变量
# 复制为 .env 后填写真实值

# PostgreSQL
POSTGRES_USER=aigc
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=aigc_dev
POSTGRES_PORT=5432

# PostgreSQL 内存调优（按宿主机物理内存调整）
# shared_buffers / effective_cache_size 建议按 1:3 比例同步放大
# 经验值：
#   4GB 服务器 → 512MB / 8MB / 128MB / 1536MB / 80 / 2g
#   8GB 服务器 → 1GB  / 16MB / 256MB / 3GB   / 80 / 3g   ← 默认
#   16GB服务器 → 2GB  / 32MB / 512MB / 8GB   / 150 / 8g
PG_SHARED_BUFFERS=1GB
PG_WORK_MEM=16MB
PG_MAINTENANCE_WORK_MEM=256MB
PG_EFFECTIVE_CACHE_SIZE=3GB
PG_MAX_CONNECTIONS=80
# 容器内存硬限制（≥ shared_buffers ×3，且留出 work_mem × max_connections 余量）
PG_CONTAINER_MEMORY_LIMIT=3g

# Redis 内存上限（防止 Redis 和 PostgreSQL 抢内存）
# allkeys-lru 策略：内存满时按 LRU 淘汰，适合 BullMQ 队列场景
REDIS_MAXMEMORY=512mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# Redis（留空则不设密码）
REDIS_PORT=6379
REDIS_PASSWORD=
