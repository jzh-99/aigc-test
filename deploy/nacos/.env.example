# ============================================================
# Nacos 配置中心服务器环境变量
# 复制为 .env 后填写真实值，.env 不提交 git
# ============================================================

# JWT 签名密钥：Base64 编码，至少 32 字符。
# 生成示例（Linux/Mac）：openssl rand -base64 48
# 该密钥用于签发控制台登录 Token，泄露后可伪造登录，必须保密。
NACOS_AUTH_TOKEN=

# 服务端身份标识 value（key 默认 serverIdentity）。
# 用于 Nacos 内部接口鉴权，任意随机字符串即可，但生产请用强随机值。
NACOS_AUTH_IDENTITY_VALUE=
