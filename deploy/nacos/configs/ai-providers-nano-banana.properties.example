# ============================================================
# Nano Banana（Gemini 通道，canvas-agent / video-studio / ai-assistant 备用）
# Data ID: ai-providers-nano-banana.properties   Group: AI_GROUP
#
# 本文件是留空模板（.example）。复制为 ai-providers-nano-banana.properties 后填真实值。
# 注意：*.properties 被 .gitignore 忽略（防止密钥入库），只有 .example 进 git。
# ============================================================

# Nano Banana 服务基址（必填，由服务提供方给出）
NANO_BANANA_API_URL=

# Nano Banana API Key（必填）
NANO_BANANA_API_KEY=

# 使用的模型名（如 gemini-2.5-flash，由服务方支持情况决定）
NANO_BANANA_MODEL=
