# Worker 服务器环境变量
# 复制为 .env 后填写真实值

# ---- 运行环境 ----
NODE_ENV=production
LOG_LEVEL=info
LOG_DIR=   # Docker 部署时由 docker-compose.yml 注入 /app/logs/worker，本地留空

# ---- 基础设施服务器地址 ----
INFRA_HOST=192.168.1.100        # 基础设施服务器 IP 或域名

# ---- 数据库（docker-compose 动态拼接，以下分量必须填写）----
POSTGRES_USER=aigc
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=aigc_dev
POSTGRES_PORT=5432
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000

# ---- Redis ----
REDIS_PORT=6379
REDIS_PASSWORD=                  # 与基础设施服务器保持一致

# ---- JWT（worker 验证内部请求签名时使用，需与 API 保持一致）----
JWT_SECRET=change-me-in-production-at-least-32-chars

# ---- 火山引擎 TOS 对象存储 ----
# 生产环境 STORAGE_DRIVER 留空（走 TOS），不要设置 S3_* 变量
TOS_ACCESS_KEY_ID=change-me-access-key-id
TOS_SECRET_ACCESS_KEY=change-me-secret-access-key
TOS_REGION=cn-shanghai
TOS_ENDPOINT=https://tos-cn-shanghai.volces.com
TOS_BUCKET=toby-ai-prod
TOS_PUBLIC_URL=https://toby-ai-prod.tos-cn-shanghai.volces.com

# ---- 第三方 AI 服务 ----
VOLCENGINE_API_KEY=
VOLCENGINE_ACCESS_KEY=
VOLCENGINE_SECRET_KEY=

# 天翼云边缘AI网关（Seedream 图片 + Seedance 视频）
CTYUN_EDGE_API_BASE_URL=https://ai.ctaigw.cn/v1
CTYUN_EDGE_API_KEY=

# Nano Banana（Gemini 通道）
NANO_BANANA_API_URL=
NANO_BANANA_API_KEY=

# Qwen（通义千问，分镜拆分 Worker 专用）
QWEN_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
QWEN_MODEL=qwen3.7-max

# Mureka（音乐生成 / 音色克隆）
MUREKA_API_KEY=
MUREKA_API_URL=

# ---- AI system prompts（生产需要直接写入本文件或通过服务器环境注入）----
AI_PROMPT_CANVAS_STORYBOARD_SPLIT="你是专业分镜师。将剧本分割成指定数量的分镜，每个分镜约3-5秒，该时段内展示的分镜不宜过长。\\n\\n字段说明：\\n- shotNumber：镜头序号（从1开始的整数）\\n- duration：时长（秒，整数，通常为3-5）\\n- sceneDescription：场景描述，包含背景环境、光线氛围、时间地点（具体视觉描述，不写抽象情感）\\n- character1：主要角色外貌描述（用外貌特征代替角色名，无则留空字符串）\\n- characterDesc1：主要角色在本镜头的动作与表情描述（无则留空字符串）\\n- character2：次要角色外貌描述（无则留空字符串）\\n- characterDesc2：次要角色在本镜头的动作与表情描述（无则留空字符串）\\n- reference：参考图引用说明（如\"角色参考见[角色图1]，背景参考见[场景图2]\"，无则留空字符串）\\n- shotType：景别（远景/全景/中景/近景/特写/大特写）\\n- characterAction：角色核心动作（简短描述，如\"转身望向窗外\"）\\n- emotion：情绪基调（如\"紧张\"\"温柔\"\"悲伤\"）\\n- sceneTags：场景标签数组（如[\"室内\",\"夜晚\",\"咖啡馆\"]）\\n- lightAtmosphere：光线与氛围（如\"暖黄色侧逆光，柔和散射\"）\\n- soundEffect：音效描述（如\"咖啡馆背景音乐，低沉钢琴\"，无则留空字符串）\\n- dialogue：台词（有则填写，无则填\"无\"）\\n- compositionPrompt：构图提示词，可直接用于AI生图，包含景别、角度、构图、主体、光影、风格（必填，详细描述）\\n- cameraMotionPrompt：运镜提示词，可直接用于AI视频生成，包含运镜方式、焦点变化、节奏（必填，详细描述）\\n\\n❌ 禁止：输出 JSON 数组以外的任何内容（无前缀说明、无代码块标记）\\n\\n严格按以下 JSON 数组格式输出，不要输出任何其他内容：\\n[\\n  {\\n    \"shotNumber\": 1,\\n    \"duration\": 10,\\n    \"sceneDescription\": \"...\",\\n    \"character1\": \"...\",\\n    \"characterDesc1\": \"...\",\\n    \"character2\": \"\",\\n    \"characterDesc2\": \"\",\\n    \"reference\": \"\",\\n    \"shotType\": \"中景\",\\n    \"characterAction\": \"...\",\\n    \"emotion\": \"...\",\\n    \"sceneTags\": [\"室内\", \"白天\"],\\n    \"lightAtmosphere\": \"...\",\\n    \"soundEffect\": \"\",\\n    \"dialogue\": \"无\",\\n    \"compositionPrompt\": \"...\",\\n    \"cameraMotionPrompt\": \"...\"\\n  }\\n]"

# 豆包（火山方舟）—— 开放接口 Ark 文本类（资讯/绘本）worker 调用
DOUBAO_API_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_API_KEY=
DOUBAO_NEWS_MODEL=doubao-seed-2-0-code-preview-260215
DOUBAO_STORYBOOK_POLISH_MODEL=doubao-pro-32k
DOUBAO_STORYBOOK_IMAGE_MODEL=seedream-4.5

# 开放接口播客 TTS（字节播客 WebSocket）
PODCAST_WS_URL=
PODCAST_APP_ID=
PODCAST_ACCESS_KEY=
PODCAST_RESOURCE_ID=
PODCAST_APP_KEY=
PODCAST_TIMEOUT_SECONDS=120

# 开放接口回调签名密钥（HMAC-SHA256，worker 回调时对紧凑 JSON body 签名）
CALLBACK_SIGNATURE_SECRET=change-me-callback-signature-secret-at-least-32-chars

# ---- AI system prompts（生产需要直接写入本文件或通过服务器环境注入）----
# 推荐做法：将 prompts 单独管理在 prompts.env 文件中
# 复制 prompts.env.example 为 prompts.env 后填写
# docker-compose.yml 会自动加载 prompts.env
AI_PROMPT_CANVAS_STORYBOARD_SPLIT=

# ---- 代理基础 URL ----
# worker 将内网存储 URL 包装为外部可访问的代理地址，填写 API 服务器公网地址
AVATAR_UPLOAD_BASE_URL=http://API_SERVER_IP:7001
AI_UPLOAD_BASE_URL=http://API_SERVER_IP:7001
